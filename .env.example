# ──────────────────────────────────────────────────────────
# 이 파일을 .env.local로 복사해서 값을 채우면 로컬이 돕니다.
#
# 커플 이름·날짜는 여기 없습니다 — src/lib/couple.ts 상수입니다.
# 업로드는 전부 서버(/api/photos)에서 처리하므로 브라우저로 나가는
# 키가 없고, 그래서 NEXT_PUBLIC_ 변수도 목 카메라 스위치 하나뿐입니다.
# ──────────────────────────────────────────────────────────

# ── 로컬 + Vercel 양쪽에 필요 ──────────────────────────────

# Supabase 대시보드 → Settings → API
SUPABASE_URL=https://your-project.supabase.co

# service_role 키. 서버 전용 — NEXT_PUBLIC_ 절대 붙이지 말 것.
# RLS를 전부 우회하는 마스터 키라 노출되면 버킷이 통째로 열립니다.
SUPABASE_SECRET_KEY=your-service-role-key

# ── Vercel 전용 (로컬 .env.local에는 넣지 않기) ─────────────

# 사이트 전체 잠금. 부스 기기에서 한 번 비밀번호를 넣으면 1년 쿠키로 통과.
# 로컬에 넣으면 개발 중에도 잠깁니다.
# BOOTH_KEY=아무-긴-비밀번호

# ── 로컬 전용 (Vercel에 절대 넣지 말 것) ────────────────────

# true면 카메라 대신 목업 영상 사용 (카메라 없는 환경에서 촬영 흐름 테스트용).
# Vercel에 넣으면 행사장에서 목업 영상이 뜹니다.
NEXT_PUBLIC_MOCK_CAMERA=true
