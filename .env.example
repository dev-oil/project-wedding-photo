# ──────────────────────────────────────────────────────────
# Vercel에 등록할 것 (Settings → Environment Variables)
# 로컬은 이 파일을 .env.local로 복사해서 값 채우면 됨
# ──────────────────────────────────────────────────────────

# Supabase (대시보드 → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# service_role 키. 서버 전용 — NEXT_PUBLIC_ 절대 붙이지 말 것 (브라우저 노출됨)
SUPABASE_SECRET_KEY=your-service-role-key

# 커플 정보 (프레임 푸터에 표시)
NEXT_PUBLIC_COUPLE_NAMES=푸키 ♥ 푸키
NEXT_PUBLIC_WEDDING_DATE=9999.12.31

# ──────────────────────────────────────────────────────────
# Vercel 전용 (로컬 .env.local에는 넣지 않기 — 넣으면 로컬도 잠김)
# ──────────────────────────────────────────────────────────

# 사이트 전체 잠금. 부스 기기에서 ?key=값 으로 한 번 열면 1년 쿠키로 통과
BOOTH_KEY=아무-긴-비밀번호

# ──────────────────────────────────────────────────────────
# 로컬 전용 (Vercel에 절대 넣지 말 것 — 행사장에서 목업 카메라 뜸)
# ──────────────────────────────────────────────────────────

# true면 카메라 대신 목업 영상 사용 (회사/카메라 없는 환경 개발용)
NEXT_PUBLIC_MOCK_CAMERA=true
